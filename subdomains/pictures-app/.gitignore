.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Photo binaries — sources + derivatives now live in Firebase Storage, not the
# repo. public/{photos,thumbs,display} are gitignored LOCAL working dirs that the
# sync/generate pipeline populates; .image-cache holds generated derivatives.
public/photos/*
!public/photos/.gitkeep
public/thumbs/
public/display/
.image-cache/

# sync script local fingerprint cache
.sync-cache.json

# Photo-pipeline scripts are local-only tooling (personal library paths +
# Lightroom workflow) — kept entirely out of the repo.
scripts/

# Firebase emulator artifacts
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
