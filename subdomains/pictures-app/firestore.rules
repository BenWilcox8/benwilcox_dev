rules_version = '2';

// The gallery manifest is world-readable but never client-writable. The sync
// uses the Admin SDK, which bypasses these rules; the website only ever reads.
service cloud.firestore {
  match /databases/{database}/documents {
    // The published gallery manifest (and anything else under `gallery`).
    match /gallery/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
